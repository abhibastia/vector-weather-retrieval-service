# Copy to .env for local development. Do NOT commit a filled-in .env.
#
# Locally, lakebase.py reads the connection URL from the Databricks secret
# scope via your CLI profile (same as in production), so you normally do not
# need LAKEBASE_URL here at all. It exists only as an escape hatch for running
# against a plain Postgres instance with no Databricks auth.

# Which profile in ~/.databrickscfg to authenticate with.
DATABRICKS_CONFIG_PROFILE=DEFAULT

LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

WEATHER_DOCUMENTS_TABLE=weather_documents
WEATHER_EMBEDDINGS_TABLE=weather_embeddings

NWS_API_BASE_URL=https://api.weather.gov
NWS_USER_AGENT=vector-weather-retrieval-service (you@example.com)

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_HOME=/tmp/.cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/tmp/.cache/huggingface

RAG_CHAT_ENDPOINT=databricks-gpt-oss-20b
